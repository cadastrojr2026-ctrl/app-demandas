// Schema do banco de dados do App de Demandas
// Setores: ESTOQUE (admin), ALMOXARIFADO e FUNDIÇÃO (usuários)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Setor {
  ESTOQUE
  ALMOXARIFADO
  FUNDICAO
}

enum Role {
  ADMIN
  USER
}

enum StatusDemanda {
  PENDENTE
  EM_ANDAMENTO
  ENTREGUE
  CONCLUIDA
  CANCELADA
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
}

enum TipoEvento {
  CRIADA
  EDITADA
  STATUS_ALTERADO
  EXCLUIDA
}

enum TipoProduto {
  ANEL
  ARGOLA
  BRINCO_FIXO
  BRINCO_MEDIO
  BRINCOS_INFANTIS
  CONJUNTOS
  CORRENTARIA
  ESCAPULARIO
  GARGANTILHA
  PINGENTE
  PULSEIRA
  TERCO
  TORNOZELEIRA
  OUTROS
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  usuario   String   @unique
  senhaHash String
  setor     Setor
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  demandasCriadas Demanda[]     @relation("CriadoPor")
  notificacoes    Notificacao[] @relation("NotificacoesRecebidas")
}

model Demanda {
  id       Int    @id @default(autoincrement())
  titulo   String
  descricao String?

  // nota livre sobre a demanda (ex: detalhe da entrega, ressalva do atendimento) —
  // diferente da descrição, que é o pedido em si.
  observacao String?

  // setor que está solicitando (origem) e setor que deve atender (responsável)
  setorSolicitante Setor
  setorResponsavel Setor

  status     StatusDemanda @default(PENDENTE)
  prioridade Prioridade    @default(MEDIA)

  // data para quando a demanda é esperada (opcional)
  prazo DateTime?

  // produtos relacionados à demanda (seleção múltipla, opcional)
  produtos TipoProduto[] @default([])

  // qual peça é, quando "Outros" está marcado em produtos — só faz sentido nesse caso
  produtoOutroDetalhe String?

  // último envio de alerta de "demanda parada" (WhatsApp) — evita notificar repetidamente
  // a cada checagem; um novo alerta só é reenviado depois de passado o intervalo mínimo.
  ultimoAlertaParadaEm DateTime?

  criadoPorId Int
  criadoPor   User @relation("CriadoPor", fields: [criadoPorId], references: [id])

  // marca dados de exemplo (seed), removíveis em lote pelo admin
  exemplo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // itens efetivamente produzidos pra atender essa demanda (código da peça + quantidade) —
  // registrados no formulário da demanda, alimentam o relatório de produção.
  itens ItemProduzido[]

  @@index([status])
  @@index([setorResponsavel])
  @@index([setorSolicitante])
}

// Item produzido (código da peça + quantidade) pra atender uma demanda. Uma demanda pode ter
// vários itens (igual ao padrão já usado em "descrição": vários códigos numa só demanda).
model ItemProduzido {
  id         Int      @id @default(autoincrement())
  demandaId  Int
  demanda    Demanda  @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  codigo     String
  quantidade Int
  createdAt  DateTime @default(now())

  @@index([demandaId])
  @@index([codigo])
}

// Notificações dentro do próprio app (ex: aviso de demanda concluída para o admin) —
// alternativa ao WhatsApp para quem não configurou nenhum provedor.
model Notificacao {
  id            Int      @id @default(autoincrement())
  paraUserId    Int
  paraUser      User     @relation("NotificacoesRecebidas", fields: [paraUserId], references: [id])
  demandaId     Int?
  demandaTitulo String?
  mensagem      String
  lida          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([paraUserId, lida])
  @@index([createdAt])
}

// Histórico de eventos das demandas (criação, edição, mudança de status, exclusão).
// Dados desnormalizados (sem relação de chave estrangeira com Demanda) para que o
// histórico sobreviva mesmo que a demanda original seja excluída.
model HistoricoEvento {
  id             Int        @id @default(autoincrement())
  demandaId      Int
  demandaTitulo  String
  tipo           TipoEvento
  descricao      String
  usuarioNome    String
  usuarioSetor   Setor
  exemplo        Boolean    @default(false)
  createdAt      DateTime   @default(now())

  // setores da demanda no momento do evento (desnormalizado, como demandaTitulo) — usado
  // para restringir o histórico de usuários não-admin às demandas do próprio setor. Nulo em
  // eventos antigos, gravados antes desses campos existirem.
  demandaSetorSolicitante Setor?
  demandaSetorResponsavel Setor?

  // só preenchido em eventos STATUS_ALTERADO — situação antes/depois da mudança. Permite
  // filtrar o histórico por situação resultante (ex: só o que virou Concluída ou Entregue)
  // sem precisar re-analisar o texto livre de "descricao".
  statusAnterior StatusDemanda?
  statusNovo     StatusDemanda?

  @@index([demandaId])
  @@index([createdAt])
  @@index([demandaSetorSolicitante])
  @@index([demandaSetorResponsavel])
  @@index([statusNovo])
}
