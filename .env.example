# Copie este arquivo para .env e preencha os valores reais.

# String de conexão do banco Postgres (ex: Neon — https://neon.tech, plano grátis).
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/nome-do-banco?sslmode=require"

# Chave para assinar o cookie de sessão (32+ caracteres aleatórios).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Segredo para autenticar a checagem automática de "demandas paradas" (rota
# /api/cron/demandas-paradas) quando chamada pelo Vercel Cron ou por um serviço externo
# (ex: cron-job.org). Gere com o mesmo comando acima. Sem essa variável, a rota só aceita
# ser chamada manualmente por um usuário ADMIN logado (botão "Testar agora" em /usuarios).
CRON_SECRET=""

# --- Notificação de WhatsApp (demandas de alta prioridade paradas) ---
# Deixe WHATSAPP_PROVIDER em branco/ausente para só registrar os alertas no log do servidor
# (nada é enviado). Veja o README.md para o passo a passo de cada provedor.
WHATSAPP_PROVIDER=""     # "callmebot" | "twilio" | "meta"

# Provedor "callmebot" (grátis, sem cartão):
CALLMEBOT_PHONE=""       # número que registrou o CallMeBot (com DDI, ex: 5511999999999)
CALLMEBOT_API_KEY=""

# Provedor "twilio" (pago, oficial):
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""  # ex: "whatsapp:+14155238886"
WHATSAPP_TO=""           # número que recebe o alerta, ex: "+5511999999999" (usado por twilio e meta)

# Provedor "meta" (oficial, Meta Cloud API):
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_CLOUD_PHONE_ID=""
