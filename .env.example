# Copie este arquivo para .env e preencha os valores reais.

# String de conexão do banco Postgres (ex: Neon — https://neon.tech, plano grátis).
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/nome-do-banco?sslmode=require"

# Chave para assinar o cookie de sessão (32+ caracteres aleatórios).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
